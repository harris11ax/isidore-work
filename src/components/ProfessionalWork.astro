---
import { professionalEntries } from '../data/professional';
import { monthYear, period } from '../lib/dates';

// Card-cover resolution, same rule as the projects grid: an explicit cover wins,
// otherwise the first image (or the first asset with a thumbnail).
function coverOf(p: (typeof professionalEntries)[number]['project']): string | null {
	if (p.cover) return p.cover;
	const asset = p.assets.find((a) => a.type === 'image' || a.thumb);
	if (!asset) return null;
	return asset.type === 'image' ? asset.src : (asset.thumb ?? null);
}

const entries = professionalEntries.map((e) => ({ ...e, cover: coverOf(e.project) }));
---

<div class="work-list">
	{entries.map(({ project, role, cover }) => (
		<article class="work-entry" id={project.slug}>
			<div class="work-head">
				<h3><a href={`/projects/${project.slug}`}>{project.name}</a></h3>
				<span class="work-when">
					{role ? period(role) : monthYear(project.date)}
				</span>
			</div>

			{role ? (
				<p class="work-org">
					{role.org}
					{role.title ? ` · ${role.title}` : ''}
					{role.location ? <span class="work-place"> — {role.location}</span> : null}
				</p>
			) : (
				<p class="work-org">{monthYear(project.date)}</p>
			)}

			<div class="work-body">
				<div class="work-text">
					{project.summary ? <p class="work-summary">{project.summary}</p> : null}

					{project.deliverables && project.deliverables.length ? (
						<>
							<p class="work-label">Deliverables</p>
							<ul class="work-contrib">
								{project.deliverables.map((d) => <li>{d}</li>)}
							</ul>
						</>
					) : null}

					{project.tools && project.tools.length ? (
						<p class="work-facts"><strong>Tools:</strong> {project.tools.join(' · ')}</p>
					) : null}

					{project.status ? <span class="status-pill">{project.status}</span> : null}

					<p class="work-links">
						<a href={`/projects/${project.slug}`}>Project page &rarr;</a>
					</p>
				</div>

				{cover ? (
					<div class="work-media">
						{/* decorative: the entry's <h3> link already names the project */}
						<img src={cover} alt="" loading="lazy" />
					</div>
				) : null}
			</div>
		</article>
	))}
</div>
