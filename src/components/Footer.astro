---
import { EMAIL, EMAIL2, GITHUB_URL, LINKEDIN_URL } from '../consts';

const today = new Date();
---

<footer>
	<div class="footer-content">
		<div class="footer-text">
			&copy; {today.getFullYear()} All rights reserved.
		</div>
		<div class="contact-buttons">
			<a href={`mailto:${EMAIL}`} class="contact-btn" title={EMAIL}>
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
				</svg>
			</a>
			<a href={`mailto:${EMAIL2}`} class="contact-btn" title={EMAIL2}>
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 2v.01L12 11 4 6.01V6h16zM4 18V8l8 5 8-5v10H4z"/>
				</svg>
			</a>
			<a href={GITHUB_URL} target="_blank" rel="noopener" class="contact-btn" title="GitHub">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0024 12.5C24 5.87 18.63.5 12 .5z"/>
				</svg>
			</a>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener" class="contact-btn" title="LinkedIn">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
				</svg>
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		padding: 2em 1em;
		background: white;
		border-top: 1px solid #e0e0e0;
		margin-top: 4em;
	}

	.footer-content {
		max-width: 1200px;
		margin: 0 auto;
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 2em;
		flex-wrap: wrap;
	}

	.footer-text {
		color: rgb(var(--gray));
		font-size: 0.9em;
	}

	.contact-buttons {
		display: flex;
		gap: 1em;
	}

	.contact-btn {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 40px;
		height: 40px;
		border-radius: 50%;
		background: #f0f0f0;
		color: rgb(var(--black));
		text-decoration: none;
		transition: background 0.2s, color 0.2s;
	}

	.contact-btn:hover {
		background: var(--accent);
		color: white;
	}

	.contact-btn svg {
		width: 20px;
		height: 20px;
		fill: currentColor;
	}

	@media (max-width: 720px) {
		.footer-content {
			justify-content: center;
			flex-direction: column;
		}

		.footer-text {
			text-align: center;
		}
	}
</style>
