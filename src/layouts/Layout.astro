---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
}

const { title, description, image = '/blog-placeholder-1.jpg' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={image} />
	</head>
	<body>
		<Header />
		<main id="main" tabindex="-1">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	/* No width/max-width here: this scoped rule (main[data-astro-cid-…]) outranks
	   global.css's `main`, so a max-width here silently defeated the responsive
	   cap and pinned every page to 1100px. The shell lives in global.css. */
	main {
		margin: 0 auto;
		padding: 2em var(--gutter);
	}
</style>
