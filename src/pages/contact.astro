---
import Layout from '../layouts/Layout.astro';
import { EMAIL, LINKEDIN_URL, INSTAGRAM_URL } from '../consts';
---

<Layout title="Contact" description="Get in touch">
	<h1>Contact</h1>
	<p>Feel free to reach out to me through any of these channels.</p>

	<div style="max-width: 600px; margin: 3em auto;">
		<h2>Email</h2>
		<p>
			<a href={`mailto:${EMAIL}`} style="font-size: 1.1em;">{EMAIL}</a>
		</p>

		<h2>Social Media</h2>
		<div class="contact-buttons">
			<a href={LINKEDIN_URL} target="_blank" class="contact-btn-large" title="LinkedIn">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
				</svg>
				LinkedIn
			</a>
			<a href={INSTAGRAM_URL} target="_blank" class="contact-btn-large" title="Instagram">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0m0 2c5.523 0 10 4.477 10 10s-4.477 10-10 10S2 17.523 2 12 6.477 2 12 2m5.521 1.175a1.5 1.5 0 110-3 1.5 1.5 0 010 3m-4.521 1.825a4.5 4.5 0 100 9 4.5 4.5 0 000-9m0 2a2.5 2.5 0 110 5 2.5 2.5 0 010-5"/>
				</svg>
				Instagram
			</a>
		</div>
	</div>
</Layout>

<style>
	.contact-buttons {
		display: flex;
		gap: 2em;
		margin: 2em 0;
	}

	.contact-btn-large {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.75em 1.5em;
		border-radius: 8px;
		background: #f0f0f0;
		color: rgb(var(--black));
		text-decoration: none;
		transition: all 0.2s;
		font-weight: 500;
	}

	.contact-btn-large:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	.contact-btn-large svg {
		width: 24px;
		height: 24px;
		fill: currentColor;
	}

	@media (max-width: 720px) {
		.contact-buttons {
			flex-direction: column;
			gap: 1em;
		}

		.contact-btn-large {
			justify-content: center;
		}
	}
</style>
