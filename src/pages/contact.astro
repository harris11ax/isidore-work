---
import Layout from '../layouts/Layout.astro';
import { EMAIL, EMAIL2, GITHUB_URL, LINKEDIN_URL } from '../consts';
---

<Layout title="Contact" description="Get in touch">
	<h1>Contact</h1>
	<p>Feel free to reach out to me through any of these channels.</p>

	<div style="max-width: 600px; margin: 3em auto;">
		<h2>Email</h2>
		<p>
			<a href={`mailto:${EMAIL}`} style="font-size: 1.1em;">{EMAIL}</a><br />
			<a href={`mailto:${EMAIL2}`} style="font-size: 1.1em;">{EMAIL2}</a>
		</p>

		<h2>Elsewhere</h2>
		<div class="contact-buttons">
			<a href={GITHUB_URL} target="_blank" rel="noopener" class="contact-btn-large" title="GitHub">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M12 .5C5.37.5 0 5.87 0 12.5c0 5.3 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58v-2.03c-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.75.08-.73.08-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5.99.11-.78.42-1.3.76-1.6-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.12-3.18 0 0 1.01-.32 3.3 1.23a11.5 11.5 0 016 0c2.29-1.55 3.3-1.23 3.3-1.23.66 1.66.25 2.88.12 3.18.77.84 1.24 1.91 1.24 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22v3.29c0 .32.22.7.83.58A12.01 12.01 0 0024 12.5C24 5.87 18.63.5 12 .5z"/>
				</svg>
				GitHub
			</a>
			<a href={LINKEDIN_URL} target="_blank" rel="noopener" class="contact-btn-large" title="LinkedIn">
				<svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
					<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.225 0z"/>
				</svg>
				LinkedIn
			</a>
		</div>
	</div>
</Layout>

<style>
	.contact-buttons {
		display: flex;
		gap: 2em;
		margin: 2em 0;
	}

	.contact-btn-large {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		padding: 0.75em 1.5em;
		border-radius: 8px;
		background: #f0f0f0;
		color: rgb(var(--black));
		text-decoration: none;
		transition: all 0.2s;
		font-weight: 500;
	}

	.contact-btn-large:hover {
		background: var(--accent);
		color: white;
		transform: translateY(-2px);
	}

	.contact-btn-large svg {
		width: 24px;
		height: 24px;
		fill: currentColor;
	}

	@media (max-width: 720px) {
		.contact-buttons {
			flex-direction: column;
			gap: 1em;
		}

		.contact-btn-large {
			justify-content: center;
		}
	}
</style>
