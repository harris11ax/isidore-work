---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { projects } from '../lib/projects';
import { DOMAINS, CATEGORIES } from '../data/domains';
import FilterableProjects from '../components/FilterableProjects.tsx';
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="bio-section">
		<img src="/blog-placeholder-about.jpg" alt="Headshot" class="bio-headshot" />
		<div class="bio-text">
			<h1>About</h1>
			<p>
				[Placeholder bio.] Electrical & computer engineering student and maker —
				work spanning power &amp; energy systems, embedded hardware, software &amp;
				data, lab research, and science-and-technology policy.
			</p>
			<p>Browse and filter {projects.length} projects below.</p>
		</div>
	</section>

	<FilterableProjects
		client:load
		projects={projects}
		domains={DOMAINS}
		categories={[...CATEGORIES]}
	/>
</Layout>
