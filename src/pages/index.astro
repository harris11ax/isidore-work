---
import Layout from '../layouts/Layout.astro';
import { SITE_TITLE, SITE_DESCRIPTION, EMAIL, GITHUB_URL, LINKEDIN_URL, LANDING } from '../consts';
import { professionalEntries, otherProjectCount } from '../data/professional';
import ProfessionalWork from '../components/ProfessionalWork.astro';

const workCount = professionalEntries.length;
const fill = (text: string, n: number) => text.replace(/\{count\}/g, String(n));
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="home-intro">
		<figure class="home-photo">
			<img src={LANDING.selfie} alt={`${LANDING.name} — portrait`} />
			{LANDING.selfieCaption ? <figcaption>{LANDING.selfieCaption}</figcaption> : null}
		</figure>

		<div class="home-intro-text">
			<h1>{LANDING.name}</h1>
			{LANDING.bio.map((paragraph) => <p set:html={paragraph} />)}

			<nav class="jump-nav" aria-label="On this page">
				<a href="#work">Professional work</a>
				<a href="/projects">All projects</a>
				<a href="/cv">CV</a>
				<a href="#contact">Contact</a>
			</nav>
		</div>
	</section>

	<section id="work" class="home-section">
		<div class="domain-head" style="border-color: var(--accent)">
			<h2 style="color: var(--accent)">{LANDING.workHeading}</h2>
			{LANDING.workBlurb ? <p set:html={fill(LANDING.workBlurb, workCount)} /> : null}
		</div>

		<ProfessionalWork />
	</section>

	<section class="home-section home-more">
		<h2>{LANDING.moreHeading}</h2>
		{LANDING.moreBlurb ? <p set:html={fill(LANDING.moreBlurb, otherProjectCount)} /> : null}
		<p><a class="more-link" href="/projects">Browse all projects &rarr;</a></p>
	</section>

	<section id="contact" class="home-section home-contact">
		<h2>{LANDING.contactHeading}</h2>
		{LANDING.contactBlurb ? <p set:html={LANDING.contactBlurb} /> : null}
		<p class="contact-links">
			<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			<a href={LINKEDIN_URL} rel="me">LinkedIn</a>
			<a href={GITHUB_URL} rel="me">GitHub</a>
		</p>
	</section>
</Layout>
