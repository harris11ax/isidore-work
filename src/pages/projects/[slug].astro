---
import Layout from '../../layouts/Layout.astro';
import { projects, getProjectBySlug, metaLine } from '../../lib/projects';
import { domainMap } from '../../data/domains';

export function getStaticPaths() {
	return projects.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props as { slug: string };
const project = getProjectBySlug(slug)!;
const domain = domainMap[project.domain];
// A project may override the domain accent; fall back to the domain colour.
const accent = project.accentColor || domain.color;
const cover = project.assets.find((a) => a.type === 'image' || a.thumb);
const coverImg = cover && (cover.type === 'image' ? cover.src : cover.thumb);
const meta = metaLine(project);

/** Minimal, deliberately small markdown subset for the long description. */
function renderBody(md: string): string {
	const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
	const inline = (s: string) =>
		esc(s)
			.replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
			.replace(/(^|[^*])\*([^*]+?)\*/g, '$1<em>$2</em>')
			.replace(/\[([^\]]+)\]\((https?:[^)\s]+|\/[^)\s]*)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
	return md
		.split(/\n{2,}/)
		.map((block) => {
			const trimmed = block.trim();
			if (!trimmed) return '';
			const bullets = trimmed.split('\n').filter((l) => /^\s*[-*]\s+/.test(l));
			if (bullets.length === trimmed.split('\n').length) {
				return `<ul>${bullets.map((l) => `<li>${inline(l.replace(/^\s*[-*]\s+/, ''))}</li>`).join('')}</ul>`;
			}
			return `<p>${inline(trimmed).replace(/\n/g, '<br>')}</p>`;
		})
		.join('\n');
}
---

<Layout title={project.name} description={project.summary || project.name} image={coverImg || '/blog-placeholder-1.jpg'}>
	<article class="project-detail">
		<a href="/projects" class="back">&larr; All projects</a>

		<div class="detail-tag" style={`background:${accent}`}>{domain.label}</div>
		<h1>{project.name}</h1>

		<div class="detail-meta">
			{meta.map((part, i) => (
				<>
					{i > 0 ? <span>·</span> : null}
					<span>{part}</span>
				</>
			))}
			{project.status ? <span class="status-pill">{project.status}</span> : null}
		</div>

		{project.summary ? <p class="detail-summary">{project.summary}</p> : null}

		{project.body ? <div class="detail-body" set:html={renderBody(project.body)} /> : null}

		{project.deliverables && project.deliverables.length ? (
			<div class="detail-facts">
				<span class="fact-label">Deliverables</span>
				<span>{project.deliverables.join(' · ')}</span>
			</div>
		) : null}

		{project.tools && project.tools.length ? (
			<div class="detail-facts">
				<span class="fact-label">Tools</span>
				<span>{project.tools.join(' · ')}</span>
			</div>
		) : null}

		{project.tags.length ? (
			<div class="card-tags">
				{project.tags.map((t) => <span class="tag">{t}</span>)}
			</div>
		) : null}

		{project.assets.length ? (
			<div class="gallery">
				{project.assets.map((a) => (
					<figure class="gallery-item">
						{a.type === 'image' ? (
							<img src={a.src} alt={a.caption || project.name} loading="lazy" />
						) : a.type === 'video' ? (
							<video src={a.src} controls poster={a.thumb} preload="metadata"></video>
						) : a.type === 'pdf' ? (
							<a href={a.src} target="_blank" rel="noopener" class="pdf-embed">
								{a.thumb ? <img src={a.thumb} alt={a.caption || 'PDF preview'} loading="lazy" /> : null}
								<span>Open PDF ↗</span>
							</a>
						) : (
							<iframe src={a.src} title={a.caption || project.name} loading="lazy"></iframe>
						)}
						{a.caption ? <figcaption>{a.caption}</figcaption> : null}
					</figure>
				))}
			</div>
		) : (
			<div class="no-assets" style={`border-color:${accent}`}>
				<p>A text-based deliverable — nothing to show here yet.</p>
			</div>
		)}
	</article>
</Layout>
