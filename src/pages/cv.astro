---
import Layout from '../layouts/Layout.astro';
import { POSITIONS, AWARDS, EDUCATION } from '../data/roles';
import { LANDING } from '../consts';
import { fmt, period } from '../lib/dates';
import { EMAIL, LINKEDIN_URL, GITHUB_URL, EMAIL2 } from '../consts';

const positions = POSITIONS.slice().sort((a, b) => (a.start < b.start ? 1 : -1));
const awards = AWARDS.slice().sort((a, b) => (a.start < b.start ? 1 : -1));
const skillList = Array.from(new Set(positions.flatMap((p) => p.skills))).sort();
---

<Layout title="Isidore LaRocco — CV" description="Experience, education, awards and credentials.">
	<div class="cv-header">
		<h1>Isidore LaRocco</h1>
		<p>
			Electrical &amp; computer engineering student at the University of Virginia; four years
			as an active-duty MH-53E helicopter airframe mechanic before that.
		</p>
		{LANDING.availability ? <p class="availability">{LANDING.availability}</p> : null}
		<div class="cv-contact">
			<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
			<a href={LINKEDIN_URL} rel="me">LinkedIn</a>
			<a href={GITHUB_URL} rel="me">GitHub</a>
			<a href="/projects">Projects ↗</a>
		</div>
	</div>

	<section class="cv-section">
		<h2>Experience</h2>
		{positions.map((role) => (
			<div class="cv-entry">
				<div class="cv-entry-head">
					<h3>{role.title}</h3>
					<span class="cv-entry-when">{period(role)}</span>
				</div>
				<p class="cv-org">
					{role.org}{role.location ? ` — ${role.location}` : ''}
					{role.employment ? ` · ${role.employment}` : ''}
				</p>
				{role.summary ? <p>{role.summary}</p> : null}
				{role.achievements.length ? (
					<ul class="cv-achievements">
						{role.achievements.map((a) => <li>{a}</li>)}
					</ul>
				) : null}
				{role.skills.length ? (
					<div class="cv-tags">
						{role.skills.map((s) => <span class="tag">{s}</span>)}
					</div>
				) : null}
			</div>
		))}
	</section>

	<section class="cv-section">
		<h2>Education</h2>
		{EDUCATION.map((e) => (
			<div class="cv-entry">
				<div class="cv-entry-head">
					<h3>{e.institution}</h3>
					<span class="cv-entry-when">{e.from}{e.to && e.to !== e.from ? ` – ${e.current ? 'present' : e.to}` : ''}</span>
				</div>
			</div>
		))}
	</section>

	<section class="cv-section">
		<h2>Awards &amp; credentials</h2>
		<ul class="cv-awards">
			{awards.map((a) => (
				<li>
					<strong>{a.title}</strong>
					{a.org ? ` — ${a.org}` : ''}
					{a.start ? <span class="cv-entry-when"> ({fmt(a.start)})</span> : null}
					{a.summary ? <div>{a.summary}</div> : null}
				</li>
			))}
		</ul>
	</section>

	{skillList.length ? (
		<section class="cv-section">
			<h2>Skills</h2>
			<div class="cv-tags">
				{skillList.map((s) => <span class="tag">{s}</span>)}
			</div>
		</section>
	) : null}

	<p class="cv-entry-when">
		Also reachable at {EMAIL2}. Full project write-ups with images and documents are on the <a href="/projects">projects page</a>.
	</p>
</Layout>
